diff --git a/src/esp/esp_tcp.cc b/src/esp/esp_tcp.cc
--- a/src/esp/esp_tcp.cc
+++ b/src/esp/esp_tcp.cc
@@ -24,8 +24,10 @@ EspTcp::~EspTcp() {
 }
 
 bool EspTcp::Connect(const std::string& host, int port) {
-    // 确保先断开已有连接
-    if (connected_) {
+    // Ensure the previous receive task has fully exited before reusing this
+    // transport. A passive disconnect clears connected_ before the task has
+    // finished unwinding.
+    if (connected_ || receive_task_handle_ != nullptr) {
         Disconnect();
     }
 
@@ -66,21 +68,37 @@ bool EspTcp::Connect(const std::string& host, int port) {
         tcp->ReceiveTask();
         xEventGroupSetBits(tcp->event_group_, ESP_TCP_EVENT_RECEIVE_TASK_EXIT);
         vTaskDelete(NULL);
-    }, "tcp_receive", 4096, this, 1, &receive_task_handle_);
+    }, "tcp_receive", 4096, this, receive_task_priority_, &receive_task_handle_);
     return true;
 }
 
+void EspTcp::SetReceiveTaskPriority(uint32_t priority) {
+    receive_task_priority_ = static_cast<UBaseType_t>(priority);
+}
+
 void EspTcp::Disconnect() {
-    // 如果已经断开，直接返回
-    if (!connected_) {
+    if (connected_) {
+        // Active disconnect: close the socket and wait for the receive task.
+        DoDisconnect(true);
         return;
     }
 
-    // 主动断开，需要等待接收任务退出
-    DoDisconnect(true);
+    // A passive disconnect sets connected_ to false from the receive task
+    // before that task signals its exit. Destruction must still wait for the
+    // signal or the task can access a deleted event group.
+    if (receive_task_handle_ != nullptr &&
+        xTaskGetCurrentTaskHandle() != receive_task_handle_) {
+        auto bits = xEventGroupWaitBits(event_group_, ESP_TCP_EVENT_RECEIVE_TASK_EXIT,
+                                        pdFALSE, pdFALSE, pdMS_TO_TICKS(10000));
+        if (!(bits & ESP_TCP_EVENT_RECEIVE_TASK_EXIT)) {
+            ESP_LOGE(TAG, "Failed to wait for receive task exit");
+        }
+        receive_task_handle_ = nullptr;
+    }
 }
 
 void EspTcp::DoDisconnect(bool wait_for_task) {
+    const bool was_connected = connected_;
     connected_ = false;
 
     if (tcp_fd_ != -1) {
@@ -94,11 +112,12 @@ void EspTcp::DoDisconnect(bool wait_for_task) {
             if (!(bits & ESP_TCP_EVENT_RECEIVE_TASK_EXIT)) {
                 ESP_LOGE(TAG, "Failed to wait for receive task exit");
             }
+            receive_task_handle_ = nullptr;
         }
     }
 
     // 断开连接时触发断开回调
-    if (disconnect_callback_) {
+    if (was_connected && disconnect_callback_) {
         disconnect_callback_();
     }
 }
